# ==============================================================================
# CosDNA AI Reverse Formulation Assistant - Backend Environment Variables
# 
# 資安規範提醒：
# 1. 複製此範本為 .env (copy .env.example .env)
# 2. 將 LLM API Key (如 Gemini 或 OpenAI) 填寫於下方
# 3. 切勿將 .env 提交至 GitHub 或暴露給前端！
# ==============================================================================

PORT=3000

# 推薦使用 Google Gemini API (伺服器端保管)
GEMINI_API_KEY=your_gemini_api_key_here

# 亦可選用 OpenAI API
# OPENAI_API_KEY=your_openai_api_key_here
